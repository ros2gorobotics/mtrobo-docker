# คัดลอกเป็นไฟล์ .env แล้วแก้ค่าตามหุ่น
MTROBO_BASE=2wd
MTROBO_LASER_SENSOR=udp_lidar
ROS_DOMAIN_ID=0

# กล้องมือถือบนหุ่น (ว่าง = ปิด) เช่น http://192.168.1.50:8080/shot.jpg หรือ http://192.168.1.50:8080/video
PHONE_CAMERA_URL=
PHONE_CAMERA_MODE=snapshot   # snapshot (/shot.jpg) หรือ mjpeg (/video)
PHONE_CAMERA_RATE=5.0
# ตำแหน่งมือถือเทียบกับ base_link (base_link สูงจากพื้น 0.075 m): ยื่นไปหน้า (m), สูง (m), ก้มลง (องศา)
CAM_X=0.10
CAM_Z=0.35
CAM_PITCH=10
